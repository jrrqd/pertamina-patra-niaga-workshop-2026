[Unit]
Description=Patra Niaga command center API (127.0.0.1:3072; nginx /patra/api/)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -u /opt/patra-cc/patra_cc.py
Environment=PATRA_PORT=3072
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PATRA_DATA_DIR=/var/www/patra-cc/data
Environment=PATRA_ORG_FILE=/var/www/patra-cc/data/org.json
Environment=PATRA_SOPS_FILE=/var/www/patra-cc/data/sops.json
Environment=PATRA_TASKS_FILE=/var/www/patra-cc/data/tasks.json
Environment=PATRA_LOG_FILE=/var/lib/patra-cc/responses.jsonl
Environment=PATRA_LOCK_FILE=/var/lib/patra-cc/patra.lock
Environment=PATRA_ALLOWED_ORIGIN=https://radr.nxtdev.xyz
EnvironmentFile=-/etc/patra-cc/forward.env
DynamicUser=yes
SupplementaryGroups=www-data
StateDirectory=patra-cc
StateDirectoryMode=0750
UMask=0027
Restart=on-failure
RestartSec=3
MemoryMax=64M
TasksMax=32
CPUQuota=50%
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
ReadWritePaths=/var/www/patra-cc/data

[Install]
WantedBy=multi-user.target
